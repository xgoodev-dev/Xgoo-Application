{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.xgoo.in",
        "EXPO_PUBLIC_OFFICE_SLUG": "demo-office"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.xgoo.in",
        "EXPO_PUBLIC_OFFICE_SLUG": "demo-office"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.xgoo.in",
        "EXPO_PUBLIC_OFFICE_SLUG": "demo-office"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
