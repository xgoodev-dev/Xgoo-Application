{
  "expo": {
    "name": "XGoo",
    "slug": "xgoo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/xgoo-logo.png",
    "scheme": "xgoo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/xgoo-logo.png",
      "bundleIdentifier": "com.murthyenterprises.xgoo",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "XGoo uses your location to set the parcel pickup point."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#17181B",
        "foregroundImage": "./assets/images/xgoo-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.murthyenterprises.xgoo",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F11",
          "image": "./assets/images/xgoo-logo.png",
          "imageWidth": 112
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/xgoo-logo.png",
          "color": "#FF4907"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2d38a1a0-62c8-4390-82a7-1186ade594a1"
      }
    },
    "owner": "xgoo"
  }
}
