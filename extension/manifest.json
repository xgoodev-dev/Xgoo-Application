{
  "manifest_version": 3,
  "name": "XGoo Partner Sync",
  "version": "1.2.0",
  "description": "Autofill courier partner booking forms from XGoo shipments.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://one.delhivery.com/*",
    "https://*.delhivery.com/*",
    "https://www.indiancourier.net/*",
    "https://*.indiancourier.net/*",
    "https://stcourier.com/*",
    "https://*.stcourier.com/*",
    "https://www.franchcourier.com/*",
    "https://*.franchcourier.com/*",
    "https://www.dtdc.in/*",
    "https://*.dtdc.in/*",
    "https://www.bluedart.com/*",
    "https://*.bluedart.com/*",
    "https://xpresion.worldfirst.in/*",
    "https://xpression.worldfirst.in/*",
    "https://www.worldfirst.in/*",
    "https://*.worldfirst.in/*",
    "https://www.ups.com/*",
    "https://*.ups.com/*",
    "https://campusship.ups.com/*",
    "https://www.fedex.com/*",
    "https://*.fedex.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "js": ["src/constants.js", "src/content-xgoo.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://one.delhivery.com/*",
        "https://*.delhivery.com/*",
        "https://www.indiancourier.net/*",
        "https://*.indiancourier.net/*",
        "https://stcourier.com/*",
        "https://*.stcourier.com/*",
        "https://www.franchcourier.com/*",
        "https://*.franchcourier.com/*",
        "https://www.dtdc.in/*",
        "https://*.dtdc.in/*",
        "https://www.bluedart.com/*",
        "https://*.bluedart.com/*",
        "https://xpresion.worldfirst.in/*",
        "https://xpression.worldfirst.in/*",
        "https://www.worldfirst.in/*",
        "https://*.worldfirst.in/*",
        "https://www.ups.com/*",
        "https://*.ups.com/*",
        "https://campusship.ups.com/*",
        "https://www.fedex.com/*",
        "https://*.fedex.com/*"
      ],
      "js": [
        "src/constants.js",
        "src/lib/dom-utils.js",
        "src/adapters/generic.js",
        "src/adapters/delhivery.js",
        "src/adapters/world-first.js",
        "src/adapters/index.js",
        "src/content-partner.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "XGoo Partner Sync",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "externally_connectable": {
    "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"]
  }
}
