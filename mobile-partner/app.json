{
  "expo": {
    "name": "XGoo Pickup",
    "slug": "xgoo-pickup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/xgoo-logo.png",
    "scheme": "xgoopickup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/xgoo-logo.png",
      "bundleIdentifier": "com.murthyenterprises.xgoopickup",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "XGoo Pickup uses your location on duty to measure kilometres travelled from sign-in to sign-out, and when you confirm a pickup point.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "XGoo Pickup tracks kilometres in the background while you are signed in on duty, so fuel cost can be calculated when you sign out."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#17181B",
        "foregroundImage": "./assets/images/xgoo-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.murthyenterprises.xgoopickup",
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "XGoo Pickup uses your location on duty to measure kilometres travelled from sign-in to sign-out.",
          "locationAlwaysAndWhenInUsePermission": "XGoo Pickup tracks kilometres while you are signed in so fuel cost can be calculated at sign-out.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F11",
          "image": "./assets/images/xgoo-logo.png",
          "imageWidth": 112
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/xgoo-logo.png",
          "color": "#FF4907"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/with-cleartext-traffic.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
